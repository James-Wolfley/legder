        <!-- External application -->
        <mxCell id="app" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F2F4;strokeColor=#7C8B99;fontColor=#1E2C39;fontSize=13;align=center;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" value="&lt;div&gt;&lt;b&gt;Application&lt;/b&gt;&lt;/div&gt;&lt;div style='font-size:10px;color:#5A6B7C'&gt;«external system»&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:11px;line-height:15px'&gt;Serializes application data as Key / Value bytes&lt;br&gt;Supplies Read, Write and Sync device adapters&lt;br&gt;Instantiates Store; serializes all access&lt;/div&gt;" vertex="1">
          <mxGeometry x="560" y="100" width="360" height="130" as="geometry"/>
        </mxCell>

        <!-- Device contract -->
