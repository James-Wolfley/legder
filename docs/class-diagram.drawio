        <mxCell id="cls-key" parent="pkg-root" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C8B99;fontColor=#1E2C39;fontSize=12;align=center;verticalAlign=top;spacingTop=5;spacingLeft=4;spacingRight=4;" value="&lt;div&gt;&lt;b&gt;Key&lt;/b&gt;&lt;/div&gt;&lt;div style='font-size:10px;color:#5A6B7C'&gt;«record»&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10.5px;line-height:15px'&gt;+ Length : Key_Length&lt;br&gt;+ Bytes : Byte_Array (1 .. K)&lt;/div&gt;" vertex="1">
